#!/usr/bin/env python3
"""SOCKS5 Proxy Server - route traffic through mihomo"""
import socket
import sys
import threading
import select

PROXY = ("127.0.0.1", 7890)

def handle_socks5(client):
    try:
        # SOCKS5 handshake
        data = client.recv(256)
        if not data or data[0] != 0x05:
            client.close()
            return
        
        # Send no auth required
        client.sendall(b'\x05\x00')
        
        # Get connect request
        data = client.recv(256)
        if not data or len(data) < 7:
            client.close()
            return
        
        cmd = data[1]
        atyp = data[3]
        
        if cmd != 0x01:  # Only CONNECT supported
            client.sendall(b'\x05\x07\x00\x01\x00\x00\x00\x00\x00\x00')
            client.close()
            return
        
        # Parse address
        if atyp == 0x01:  # IPv4
            dst_addr = socket.inet_ntoa(data[4:8])
            dst_port = int.from_bytes(data[8:10], 'big')
        elif atyp == 0x03:  # Domain
            domain_len = data[4]
            dst_addr = data[5:5+domain_len].decode()
            dst_port = int.from_bytes(data[5+domain_len:5+domain_len+2], 'big')
        elif atyp == 0x04:  # IPv6
            dst_addr = socket.inet_ntop(socket.AF_INET6, data[4:20])
            dst_port = int.from_bytes(data[20:22], 'big')
        else:
            client.sendall(b'\x05\x08\x00\x01\x00\x00\x00\x00\x00\x00')
            client.close()
            return
        
        # Connect through HTTP CONNECT proxy
        remote = socket.create_connection(PROXY, timeout=10)
        req = f"CONNECT {dst_addr}:{dst_port} HTTP/1.0\r\nHost: {dst_addr}:{dst_port}\r\n\r\n"
        remote.sendall(req.encode())
        
        resp = b""
        while b"\r\n\r\n" not in resp:
            chunk = remote.recv(4096)
            if not chunk:
                raise Exception("Proxy closed")
            resp += chunk
        
        if b"200" not in resp.split(b"\r\n")[0]:
            remote.close()
            client.sendall(b'\x05\x05\x00\x01\x00\x00\x00\x00\x00\x00')
            client.close()
            return
        
        # Success
        client.sendall(b'\x05\x00\x00\x01\x00\x00\x00\x00\x00\x00')
        
        # Bidirectional relay
        sockets = [client, remote]
        while True:
            r, _, _ = select.select(sockets, [], [], 60)
            if not r:
                break
            for src in r:
                dst = remote if src is client else client
                data = src.recv(8192)
                if not data:
                    return
                dst.sendall(data)
    except Exception:
        pass
    finally:
        client.close()

if __name__ == "__main__":
    port = int(sys.argv[1]) if len(sys.argv) > 1 else 1080
    server = socket.socket()
    server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    server.bind(("127.0.0.1", port))
    server.listen(128)
    print(f"SOCKS5 proxy on 127.0.0.1:{port} → HTTP proxy {PROXY[0]}:{PROXY[1]}")
    
    while True:
        client, addr = server.accept()
        threading.Thread(target=handle_socks5, args=(client,), daemon=True).start()
